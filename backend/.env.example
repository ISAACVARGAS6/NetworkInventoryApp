# Network configuration
NETWORK=192.168.1.0/24
# Comma-separated CIDRs accepted by POST /api/scans. Defaults to NETWORK.
AUTHORIZED_NETWORKS=192.168.1.0/24
MAX_HOSTS_PER_SCAN=1024
# Absolute path is optional; by default backend/oui.txt is used.
# OUI_FILE=./oui.txt

# Scanner configuration
DISCOVERY_TIMEOUT=500
PORT_TIMEOUT=0.25

# Thread configuration
DISCOVERY_WORKERS=50
PORT_WORKERS=30
